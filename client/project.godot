; Godot 4 project configuration for the myRoomie client.
; Open this folder in Godot 4.2+ to run the game.

config_version=5

[application]

config/name="myRoomie"
config/description="Live with a roomie who keeps living while you're away."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Api="*res://scripts/Api.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=820
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
